<Window x:Class="DeskMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DeskMonitor" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="DeskMonitor · 桌面行情" Width="400" Height="332" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Topmost="True" Loaded="WindowLoaded" Closing="WindowClosing" SourceInitialized="WindowSourceInitialized" PreviewMouseLeftButtonDown="DragWindow">
 <!-- A minimal DWM frame avoids WindowChrome's separate, aliased window region.
      The opaque window background covers the glass; DWM alone rounds the outer edge. -->
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="Frame" Padding="12,10,12,0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="Header" Height="36" Background="Transparent" Margin="5,0,5,8" Cursor="SizeAll" ToolTip="按住卡片拖动；右键打开设置">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock Text="DESK / MARKET" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="设置与币种管理" AutomationProperties.Name="设置" Click="OpenSettings"/>
     <Button x:Name="PinButton" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="置顶" AutomationProperties.Name="切换置顶" Click="TogglePin"/>
     <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘" Click="HideToTray"/>
     <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="退出" AutomationProperties.Name="退出" Click="ExitApp"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ContentControl x:Name="DateProgressHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <ScrollViewer x:Name="CardsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><local:CardColumnsPanel x:Name="CardsPanel"/></ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
