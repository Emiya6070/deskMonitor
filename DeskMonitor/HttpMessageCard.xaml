<UserControl x:Class="DeskMonitor.HttpMessageCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border x:Name="CardRoot" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14,11" Margin="0,0,0,8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,8,0,7" TextWrapping="Wrap" MaxHeight="120" Foreground="{DynamicResource TextBrush}"/>
   <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Border>
</UserControl>
